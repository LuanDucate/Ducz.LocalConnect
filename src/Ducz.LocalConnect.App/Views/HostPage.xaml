<Page
  x:Class="Ducz.LocalConnect.App.Views.HostPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:Ducz.LocalConnect.App.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:HostViewModel}"
  Title="Host">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,24,32,32" MaxWidth="1040" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
        <TextBlock Style="{StaticResource PageTitle}" Text="Host" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Let another computer on your network view and control this one." />
      </StackPanel>

      <!-- Left column -->
      <StackPanel Grid.Row="1" Grid.Column="0">
        <ui:Card Style="{StaticResource SectionCard}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
              Width="48"
              Height="48"
              Margin="0,0,16,0"
              VerticalAlignment="Top"
              Background="{DynamicResource AccentFillColorDefaultBrush}"
              CornerRadius="24">
              <ui:SymbolIcon FontSize="24" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Symbol="ShareScreenStart24" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding StateTitle}" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" FontSize="13" Text="{Binding StateDescription}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:Button
                Appearance="Primary"
                Command="{Binding StartCommand}"
                Content="Start host"
                Icon="{ui:SymbolIcon Play24}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
              <ui:Button
                Appearance="Secondary"
                Command="{Binding StopCommand}"
                Content="Stop"
                Icon="{ui:SymbolIcon Stop24}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <ui:Card Style="{StaticResource SectionCard}">
          <StackPanel IsEnabled="{Binding CanEditSettings}">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Access" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                <ui:NumberBox
                  ClearButtonEnabled="False"
                  Maximum="{Binding MaxPort}"
                  Minimum="{Binding MinPort}"
                  SpinButtonPlacementMode="Inline"
                  Value="{Binding Port, Mode=TwoWay, Converter={StaticResource IntToDouble}}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="PIN the client must enter" />
                <ui:PasswordBox
                  Password="{Binding Pin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="Choose a PIN"
                  RevealButtonEnabled="True" />
              </StackPanel>

              <ui:Button
                Grid.Column="4"
                VerticalAlignment="Bottom"
                Command="{Binding GeneratePinCommand}"
                Content="Random"
                Icon="{ui:SymbolIcon ArrowSync24}"
                ToolTip="Generate a new six-digit PIN" />
            </Grid>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}">
              <Run Text="Video and input use the port above; audio uses the next one (" /><Run Text="{Binding AudioPort, Mode=OneWay}" /><Run Text="). Both must be allowed through the Windows firewall." />
            </TextBlock>

            <CheckBox
              Margin="0,14,0,0"
              Content="Start the host automatically when Windows starts"
              IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
              ToolTip="Launches the app at login and starts hosting with this PIN, minimized to the notification area." />
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource SectionCard}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="Activity" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                  Appearance="Transparent"
                  Command="{Binding OpenReceivedFolderCommand}"
                  Content="Received files"
                  Icon="{ui:SymbolIcon FolderOpen24}"
                  ToolTip="{Binding ReceivedFilesDirectory}" />
                <ui:Button
                  Appearance="Transparent"
                  Command="{Binding ClearLogCommand}"
                  Icon="{ui:SymbolIcon Delete24}"
                  ToolTip="Clear" />
              </StackPanel>
            </Grid>
            <TextBlock
              Style="{StaticResource Muted}"
              Text="Nothing yet. Events will show up here once the host starts."
              Visibility="{Binding Log.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=Invert}" />
            <ItemsControl MaxHeight="260" ItemsSource="{Binding Log}">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LogEntry}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Consolas" Style="{StaticResource Muted}" Text="{Binding TimeText}" />
                    <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="{Binding Message}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>
      </StackPanel>

      <!-- Right column -->
      <StackPanel Grid.Row="1" Grid.Column="2">
        <ui:Card Style="{StaticResource SectionCard}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="This computer's addresses" />
              <ui:Button
                HorizontalAlignment="Right"
                Appearance="Transparent"
                Command="{Binding RefreshAddressesCommand}"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                ToolTip="Refresh" />
            </Grid>
            <TextBlock Margin="0,0,0,12" Style="{StaticResource Muted}" Text="The client types one of these in its Host field. The first one is usually right." />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="No network connection detected."
              Visibility="{Binding Addresses.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=Invert}" />
            <ItemsControl ItemsSource="{Binding Addresses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                    Margin="0,0,0,8"
                    Padding="12,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock FontFamily="Consolas" FontSize="16" Text="{Binding Ip}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding InterfaceName}" />
                      </StackPanel>
                      <ui:Button
                        Grid.Column="1"
                        Appearance="Secondary"
                        Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding Ip}"
                        Icon="{ui:SymbolIcon Copy24}"
                        ToolTip="Copy" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="How it works" />
            <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap">
              1. Start the host and tell the other person your address and PIN.<LineBreak />
              2. On their computer, open Ducz LocalConnect → Connect.<LineBreak />
              3. They see your screen, hear your audio and can control the mouse and keyboard.<LineBreak /><LineBreak />
              Everything stays on your local network. Only one client can connect at a time.
            </TextBlock>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
