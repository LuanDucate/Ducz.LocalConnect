<Page
  x:Class="Ducz.LocalConnect.App.Views.ConnectPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:Ducz.LocalConnect.App.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:ConnectViewModel}"
  Title="Connect">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,24,32,32" MaxWidth="1040" HorizontalAlignment="Left">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
        <TextBlock Style="{StaticResource PageTitle}" Text="Connect" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="View and control a computer that is running Ducz LocalConnect as a host." />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="0">
        <ui:Card Style="{StaticResource SectionCard}">
          <StackPanel IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBool}}">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Host" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Address" />
            <ui:TextBox
              Icon="{ui:SymbolIcon Desktop24}"
              PlaceholderText="192.168.1.20 or a computer name"
              Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                <ui:NumberBox
                  ClearButtonEnabled="False"
                  Maximum="{Binding MaxPort}"
                  Minimum="{Binding MinPort}"
                  SpinButtonPlacementMode="Inline"
                  Value="{Binding Port, Mode=TwoWay, Converter={StaticResource IntToDouble}}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="PIN" />
                <ui:PasswordBox
                  Password="{Binding Pin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="PIN shown on the host"
                  RevealButtonEnabled="True" />
              </StackPanel>
            </Grid>

            <ui:InfoBar
              Margin="0,16,0,0"
              IsClosable="False"
              IsOpen="{Binding HasError, Mode=OneWay}"
              Message="{Binding ErrorMessage}"
              Severity="Error"
              Title="Could not connect" />

            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
              <ui:Button
                Appearance="Primary"
                Command="{Binding ConnectCommand}"
                Content="Connect"
                Icon="{ui:SymbolIcon PlugConnected24}"
                IsDefault="True" />
              <ui:ProgressRing
                Width="22"
                Height="22"
                Margin="14,0,0,0"
                IsIndeterminate="True"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Muted}"
                Text="Connecting…"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </StackPanel>
        </ui:Card>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2">
        <ui:Card Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Recent hosts" />
            <TextBlock
              Style="{StaticResource Muted}"
              Text="Hosts you connect to will be listed here."
              Visibility="{Binding RecentHosts.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=Invert}" />
            <ItemsControl ItemsSource="{Binding RecentHosts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Appearance="Secondary"
                      Command="{Binding DataContext.UseRecentHostCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                      CommandParameter="{Binding}"
                      Content="{Binding}"
                      FontFamily="Consolas"
                      Icon="{ui:SymbolIcon History24}" />
                    <ui:Button
                      Grid.Column="1"
                      Margin="6,0,0,0"
                      Appearance="Transparent"
                      Command="{Binding DataContext.ForgetRecentHostCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                      CommandParameter="{Binding}"
                      Icon="{ui:SymbolIcon Dismiss24}"
                      ToolTip="Forget" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="While connected" />
            <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Text="F11" /> full screen · <Run FontWeight="SemiBold" Text="Esc" /> leave full screen<LineBreak />
              <Run FontWeight="SemiBold" Text="Ctrl + Alt + Home" /> toggle whether the keyboard goes to the remote computer<LineBreak /><LineBreak />
              Audio from the host plays automatically. Use the toolbar to move the clipboard or send a file.
            </TextBlock>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
