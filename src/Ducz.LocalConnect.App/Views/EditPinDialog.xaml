<ui:FluentWindow
  x:Class="Ducz.LocalConnect.App.Views.EditPinDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Edit saved connection"
  Width="440"
  Height="Auto"
  MinHeight="360"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Edit saved connection" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="20,8,20,20">
      <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Name" />
      <ui:TextBox x:Name="NameBox" Margin="0,0,0,12" />

      <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Host (IP or computer name)" />
      <ui:TextBox x:Name="HostBox" Icon="{ui:SymbolIcon Desktop24}" Margin="0,0,0,4" />
      <TextBlock
        Margin="0,0,0,12"
        FontSize="11"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        TextWrapping="Wrap"
        Text="Tip: use the computer's name instead of its IP - then it keeps working even if the IP changes." />

      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Port" />
          <ui:NumberBox x:Name="PortBox" ClearButtonEnabled="False" SpinButtonPlacementMode="Inline" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="PIN" />
          <ui:PasswordBox x:Name="PinBox" RevealButtonEnabled="True" />
        </StackPanel>
      </Grid>

      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,8,0"
          Click="Cancel_Click"
          Content="Cancel" />
        <ui:Button
          Appearance="Primary"
          Click="Save_Click"
          Content="Save"
          IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
