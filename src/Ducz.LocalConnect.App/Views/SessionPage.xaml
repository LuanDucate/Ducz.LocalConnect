<Page
  x:Class="Ducz.LocalConnect.App.Views.SessionPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:Ducz.LocalConnect.App.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:SessionViewModel}"
  Title="Session">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border
      Grid.Row="0"
      Padding="12,8"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="0,0,0,1"
      IsEnabled="{Binding IsConnected}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- WrapPanel so the toolbar folds onto a second line instead of clipping in narrow windows. -->
        <WrapPanel Orientation="Horizontal">
          <WrapPanel.Resources>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
          </WrapPanel.Resources>
          <ui:Button
            Command="{Binding TogglePinCommand}"
            Content="{Binding PinText}"
            Icon="{ui:SymbolIcon Pin24}"
            ToolTip="Keep this connection in the sidebar so it's one click to reconnect, even after disconnecting." />
          <ui:TextBox
            MinWidth="140"
            Margin="0,0,8,0"
            Icon="{ui:SymbolIcon Tag24}"
            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Rename this session (also updates the name in the left menu)" />
          <ComboBox
            MinWidth="240"
            Margin="0,0,8,0"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding Monitors}"
            SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
            ToolTip="Which remote monitor to view" />
          <ui:Button
            Command="{Binding ToggleKeyboardCaptureCommand}"
            Content="{Binding KeyboardCaptureText}"
            Icon="{ui:SymbolIcon Keyboard24}"
            ToolTip="Ctrl+Alt+Home - send keystrokes to the remote computer, or keep them here" />
          <ui:Button
            Command="{Binding ToggleFullScreenCommand}"
            Content="{Binding FullScreenText}"
            Icon="{ui:SymbolIcon FullScreenMaximize24}"
            ToolTip="F11" />
          <ui:Button
            Command="{Binding SendClipboardCommand}"
            Content="Send clipboard"
            Icon="{ui:SymbolIcon ClipboardArrowRight24}"
            ToolTip="Copy your clipboard text to the host" />
          <ui:Button
            Command="{Binding FetchClipboardCommand}"
            Content="Fetch clipboard"
            Icon="{ui:SymbolIcon ClipboardPaste24}"
            ToolTip="Copy the host's clipboard text here" />
          <ui:Button
            Command="{Binding SendFileCommand}"
            Content="Send file"
            Icon="{ui:SymbolIcon ArrowUpload24}"
            ToolTip="Send a file to the host's desktop folder" />
          <ui:Button
            Command="{Binding ToggleMuteCommand}"
            Content="{Binding MuteText}"
            Icon="{ui:SymbolIcon Speaker224}"
            ToolTip="Mute or unmute the host's audio" />
          <ui:Button
            Command="{Binding SendCtrlAltDelCommand}"
            Content="Ctrl+Alt+Del"
            Icon="{ui:SymbolIcon LockClosed24}"
            ToolTip="Press Ctrl+Alt+Del on the host (the host's policy must allow it)" />
          <ComboBox
            MinWidth="120"
            Margin="4,0,0,0"
            ItemsSource="{Binding Qualities}"
            SelectedItem="{Binding Quality, Mode=TwoWay}"
            ToolTip="Picture quality. Sharp keeps text crisp on a wired LAN; Lossless is pixel-perfect but heavy." />
        </WrapPanel>

        <ui:Button
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Top"
          Appearance="Danger"
          Command="{Binding DisconnectCommand}"
          Content="Disconnect"
          Icon="{ui:SymbolIcon PlugDisconnected24}" />
      </Grid>
    </Border>

    <!-- Remote screen -->
    <Grid Grid.Row="1" Background="#101010">
      <ContentControl x:Name="ScreenHost" />

      <Border
        Background="#F0202020"
        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ui:SymbolIcon FontSize="48" Foreground="#9A9A9A" Symbol="PlugDisconnected24" />
          <TextBlock
            Margin="0,12,0,4"
            HorizontalAlignment="Center"
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="#EEEEEE"
            Text="No active session" />
          <TextBlock
            HorizontalAlignment="Center"
            Foreground="#9A9A9A"
            Text="{Binding StatusText}" />
          <ui:Button
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            Appearance="Primary"
            Click="GoToConnect_Click"
            Content="Connect to a host"
            Icon="{ui:SymbolIcon PlugConnected24}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border
      Grid.Row="2"
      Padding="12,6"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding StatusText}" />
          <ProgressBar
            Width="160"
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            Maximum="100"
            Value="{Binding TransferProgress, Mode=OneWay}"
            Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <StackPanel.Resources>
            <Style TargetType="Border">
              <Setter Property="Margin" Value="6,0,0,0" />
              <Setter Property="Padding" Value="8,2" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
              <Setter Property="FontFamily" Value="Consolas" />
            </Style>
          </StackPanel.Resources>
          <Border ToolTip="Frames per second">
            <TextBlock Text="{Binding FpsText}" />
          </Border>
          <Border ToolTip="Incoming video bandwidth">
            <TextBlock Text="{Binding BandwidthText}" />
          </Border>
          <Border ToolTip="Round-trip latency">
            <TextBlock Text="{Binding LatencyText}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
