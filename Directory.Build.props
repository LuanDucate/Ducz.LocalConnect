<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.1</Version>
    <Authors>Luan Ducate</Authors>
    <Company>Ducz</Company>
    <Product>Ducz LocalConnect</Product>
    <Copyright>Copyright © 2026 Luan Michel Ducate</Copyright>
    <RepositoryUrl>https://github.com/LuanDucate/Ducz.LocalConnect</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
